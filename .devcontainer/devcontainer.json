{
    "forwardPorts": [8000, 3001],
    "portsAttributes": {
        "8000": {
            "label": "Python Server",
            "onAutoForward": "notify"
        },
        "3001": {
            "label": "Live Preview",
            "onAutoForward": "silent"
        }
    },
    "postStartCommand": "gh codespace ports visibility 8000:public -c $CODESPACE_NAME || echo 'Auto-public failed'"
}